{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/Inicio.html",
      "permanent": false
    },
    {
      "source": "/InicioIniciarSesion.html",
      "destination": "/Inicio.html",
      "permanent": true
    },
    {
      "source": "/InicioInciarSesion.html",
      "destination": "/Inicio.html",
      "permanent": true
    },
    {
      "source": "/InicioCrearCuenta.html",
      "destination": "/Inicio.html",
      "permanent": true
    },
    {
      "source": "/RestablecerPassword.html",
      "destination": "/Inicio.html",
      "permanent": true
    },
    {
      "source": "/perfil.html",
      "destination": "/Inicio.html",
      "permanent": true
    },
    {
      "source": "/directorio-academico.html",
      "destination": "/directorio.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/push-sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    }
  ]
}
